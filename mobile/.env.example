# Use the existing browser application's public Supabase project values.
# These are public client identifiers, never a service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# The web app's public URL — used by the mobile app to call push-notification
# routes after sending a message. Set to your Vercel deployment URL.
EXPO_PUBLIC_WEB_APP_URL=https://your-app.vercel.app

# EAS project ID — copy from https://expo.dev after running `eas init`.
# Also set extra.eas.projectId in app.json to the same value.
# Without this, push notifications are gracefully disabled (not a crash).
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
