{
  "expo": {
    "name": "Smart & Thrive",
    "slug": "smart-thrive-school",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartthrive",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartthrive.school"
    },
    "android": {
      "package": "com.smartthrive.school",
      "adaptiveIcon": {
        "backgroundColor": "#0F2A47"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Smart & Thrive uses the camera only for school features you choose, such as attendance and exam verification."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0F2A47",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Smart & Thrive uses your photos only when you choose to attach one to a message."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ddb264d8-d268-42af-99fa-54d7268ba34e"
      }
    },
    "owner": "ocpdeji"
  }
}
